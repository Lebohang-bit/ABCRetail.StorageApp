@{
    ViewData["Title"] = "Dashboard - ABC Retail";
}

<div class="dashboard-welcome">
    <h1><i class="fas fa-crown"></i> ABC <span>Retail</span></h1>
    <p class="text-muted-gold">Azure-Powered Premium Order Processing System</p>
    <div class="row mt-5">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-number" id="customerCount">1,284</div>
                <div class="stat-label">Customers</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-box"></i></div>
                <div class="stat-number" id="productCount">347</div>
                <div class="stat-label">Products</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
                <div class="stat-number" id="orderCount">56</div>
                <div class="stat-label">Pending Orders</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-file-alt"></i></div>
                <div class="stat-number" id="logCount">12</div>
                <div class="stat-label">Log Files</div>
            </div>
        </div>
    </div>
    <hr class="hr-gold" />
    <div class="row">
        <div class="col-md-4">
            <a href="/Customers/Create" class="btn btn-gold w-100">
                <i class="fas fa-user-plus"></i> Add Customer
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Products/Create" class="btn btn-gold w-100">
                <i class="fas fa-plus-circle"></i> Add Product
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Orders/CreateOrder" class="btn btn-gold w-100">
                <i class="fas fa-cart-plus"></i> Create Order
            </a>
        </div>
    </div>
</div>