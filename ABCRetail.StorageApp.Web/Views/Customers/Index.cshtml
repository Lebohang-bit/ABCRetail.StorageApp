@model IEnumerable<ABCRetail.StorageApp.Web.Models.CustomerProfile>

@{
    ViewData["Title"] = "Customers - ABC Retail";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="gold-text"><i class="fas fa-users"></i> Customers</h2>
    <a href="/Customers/Create" class="btn btn-gold">
        <i class="fas fa-user-plus"></i> Add Customer
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-gold">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Loyalty Tier</th>
                    <th>Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td><strong class="gold-text">@customer.FullName</strong></td>
                            <td>@customer.Email</td>
                            <td>@customer.Phone</td>
                            <td><span class="badge badge-gold">@customer.LoyaltyTier</span></td>
                            <td>@customer.RegistrationDate?.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a href="/Customers/Details/@customer.RowKey" class="btn btn-sm btn-outline-gold">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted-gold py-4">
                            <i class="fas fa-users fa-3x d-block mb-3" style="opacity: 0.3;"></i>
                            <h5 class="text-muted-gold">No customers found</h5>
                            <p class="text-muted-gold">Click <a href="/Customers/Create" class="gold-text">Add Customer</a> to get started</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}